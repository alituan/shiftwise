rules_version = '2';

// Deny-by-default Firestore rules — Firestore rules plus Cloud Functions are
// this app's entire security boundary (docs/threat-model.md).
//
// Shift writes go exclusively through the writeShift callable
// (functions/src/write_shift.ts): the Admin SDK bypasses these rules, so
// that function owns schema validation, revision monotonicity, and conflict
// detection (docs/architecture/offline-conflict-resolution.md). Closing
// direct client writes here is what makes the guard unbypassable.
//
// Every rule change ships with emulator tests in the same commit
// (rules-tests/, docs/testing.md).
service cloud.firestore {
  match /databases/{database}/documents {

    // Server-owned collections: denied to every client, signed in or not.
    // Cloud Functions write these with administrative credentials.
    match /entitlements/{uid} {
      allow read, write: if false;
    }
    match /usage/{id} {
      allow read, write: if false;
    }
    match /rulePacks/{id} {
      allow read, write: if false;
    }
    match /webhookEvents/{id} {
      allow read, write: if false;
    }

    match /users/{uid} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }

      // Profile document: owner-readable, owner-creatable with a minimal
      // validated shape. Updates and deletes arrive with the sync and
      // account-deletion steps, each with their own emulator tests.
      allow read: if isOwner();
      allow create: if isOwner()
          && request.resource.data.keys().hasAll(['createdAt', 'email'])
          && request.resource.data.keys().hasOnly(['createdAt', 'email'])
          && request.resource.data.email is string
          && request.resource.data.createdAt == request.time;
      allow update, delete: if false;

      // Jobs and rate versions: readable by the owner; client writes open
      // with the sync step (free tier is one job, created on first sync).
      match /jobs/{jobId} {
        allow read: if isOwner();
        allow write: if false;
        match /rateVersions/{rateId} {
          allow read: if isOwner();
          allow write: if false;
        }
      }

      // Parse jobs: readable by the owner, but authority stays server-side —
      // clients never write transitions (AGENTS.md hard rule).
      match /parseJobs/{parseJobId} {
        allow read: if isOwner();
        allow write: if false;
      }

      // Calculation snapshots: server-owned writes, owner-readable for pay
      // traceability (docs/design/screens.md, Pay).
      match /calculationSnapshots/{id} {
        allow read: if isOwner();
        allow write: if false;
      }

      // Shifts: owner-readable only — every write (create, edit, delete)
      // goes through the writeShift Cloud Function, which validates the
      // schema, enforces revision monotonicity, and returns CONFLICT
      // instead of silently overwriting stale writes.
      match /shifts/{shiftId} {
        allow read: if isOwner();
        allow write: if false;
      }
    }
  }
}
